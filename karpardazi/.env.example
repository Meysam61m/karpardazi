APP_NAME="سامانه کارپردازی مجتمع خراسان"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost/karpardazi/public
APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=karpardazi
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=sync
BCRYPT_ROUNDS=12
